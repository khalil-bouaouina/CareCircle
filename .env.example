# Copy to .env. Every variable has a safe default; none of them is required.

# SQLite database file. Resetting the database is deleting this file.
ELDERCARE_DB_PATH=data/carecircle.db
ELDERCARE_DATA_DIR=data

# Base URL used to build the worker link shown on the visit-created page.
ELDERCARE_BASE_URL=http://127.0.0.1:8000

# Leave empty to run on the deterministic fallback path. Nothing crashes without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
