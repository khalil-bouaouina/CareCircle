# Copy to .env and export, or set in the shell. Everything is optional.

# SQLite file. Resetting the database is deleting this file (or POST /reset).
ELDERCARE_DB_PATH=data/eldercare.db

# Base URL used to build the worker link returned by POST /caregiver/visits.
ELDERCARE_FRONTEND_BASE_URL=http://127.0.0.1:8000

# Seed the demo data on first start (1/0).
ELDERCARE_SEED_ON_STARTUP=1

# Model provider. Leave empty to run on the deterministic fallback path.
ANTHROPIC_API_KEY=
