# Copy this file to .env and adjust if needed. All variables have safe defaults.

# SQLite database file path
ELDERCARE_DB_PATH=data/eldercare.db
ELDERCARE_DATA_DIR=data

# Base URL used to build the worker link returned by POST /caregiver/visits
ELDERCARE_FRONTEND_BASE_URL=http://127.0.0.1:8000

# Seed demo data on first start (1/0)
ELDERCARE_SEED_ON_STARTUP=1

# Secret key for HMAC session cookie signing
ELDERCARE_SECRET_KEY=carecircle-secret-key-change-in-production

# Enable /reset endpoint (1 for demo, 0 for strict production)
ELDERCARE_ENABLE_DEMO_RESET=1

# Model provider. Leave empty to run on the zero-cost deterministic fallback path.
ANTHROPIC_API_KEY=
